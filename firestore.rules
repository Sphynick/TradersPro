rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny: client reads and writes go through /api/* using Firebase ID tokens.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidRef(id) {
      return id is string && id.size() >= 6 && id.size() <= 80 && id.matches('^[a-zA-Z0-9._\\-]+$');
    }

    // Safe public read-only order status doc (no PII; only status, approved boolean, and botId)
    match /orderStatus/{orderRef} {
      allow get: if isValidRef(orderRef);
      allow list, write: if false;
    }
  }
}
