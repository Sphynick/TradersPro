rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Core helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'cyyfuego@gmail.com'
      );
    }

    // Validation blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'country', 'theme', 'licenses', 'signalSubEnd', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'country', 'theme', 'licenses', 'signalSubEnd', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.country is string && data.country.size() >= 2 && data.country.size() <= 8
        && data.theme in ['light', 'dark']
        && data.licenses is list && data.licenses.size() <= 50
        && (data.licenses.size() == 0 || data.licenses[0] is string)
        && data.signalSubEnd is number && data.signalSubEnd >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'itemId', 'itemName', 'method', 'status', 'amountKsh', 'amountUsd', 'phone', 'reference', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'userEmail', 'itemId', 'itemName', 'method', 'status', 'amountKsh', 'amountUsd', 'phone', 'reference', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160
        && isValidId(data.itemId) && data.itemId.size() <= 64
        && data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 120
        && data.method in ['mpesa_stk', 'mpesa_pochi', 'paypal']
        && data.status in ['pending', 'paid', 'failed', 'cancelled']
        && data.amountKsh is number && data.amountKsh >= 0 && data.amountKsh <= 1000000
        && data.amountUsd is number && data.amountUsd >= 0 && data.amountUsd <= 10000
        && data.phone is string && data.phone.size() <= 24
        && data.reference is string && data.reference.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSignal(data) {
      return data.keys().hasAll(['pair', 'direction', 'entry', 'stopLoss', 'takeProfit', 'timeframe', 'strategy', 'status', 'published', 'notes', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['pair', 'direction', 'entry', 'stopLoss', 'takeProfit', 'timeframe', 'strategy', 'status', 'published', 'notes', 'authorId', 'createdAt', 'updatedAt'])
        && data.pair is string && data.pair.size() >= 2 && data.pair.size() <= 24
        && data.direction in ['BUY', 'SELL']
        && data.entry is string && data.entry.size() >= 1 && data.entry.size() <= 24
        && data.stopLoss is string && data.stopLoss.size() >= 1 && data.stopLoss.size() <= 24
        && data.takeProfit is string && data.takeProfit.size() >= 1 && data.takeProfit.size() <= 24
        && data.timeframe is string && data.timeframe.size() >= 1 && data.timeframe.size() <= 12
        && data.strategy is string && data.strategy.size() >= 1 && data.strategy.size() <= 64
        && data.status in ['active', 'tp_hit', 'sl_hit', 'closed']
        && data.published is bool
        && data.notes is string && data.notes.size() <= 400
        && isValidId(data.authorId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMt5Config(data) {
      return data.keys().hasAll(['userId', 'eaId', 'eaKey', 'symbol', 'mode', 'lotSize', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'eaId', 'eaKey', 'symbol', 'mode', 'lotSize', 'enabled', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.eaId in ['xauusd-system', 'straddle-system']
        && data.eaKey is string && data.eaKey.size() >= 4 && data.eaKey.size() <= 64
        && data.symbol is string && data.symbol.size() >= 3 && data.symbol.size() <= 16
        && data.mode in ['intraday', 'scalping']
        && data.lotSize is number && data.lotSize >= 0.01 && data.lotSize <= 100
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTradeLog(data) {
      return data.keys().hasAll(['userId', 'botId', 'botName', 'market', 'contract', 'stake', 'profit', 'accountType', 'createdAt'])
        && data.keys().hasOnly(['userId', 'botId', 'botName', 'market', 'contract', 'stake', 'profit', 'accountType', 'createdAt'])
        && isValidId(data.userId)
        && data.botId is string && data.botId.size() >= 1 && data.botId.size() <= 64
        && data.botName is string && data.botName.size() >= 1 && data.botName.size() <= 100
        && data.market is string && data.market.size() >= 1 && data.market.size() <= 32
        && data.contract is string && data.contract.size() >= 1 && data.contract.size() <= 32
        && data.stake is number && data.stake >= 0.35 && data.stake <= 50000
        && data.profit is number && data.profit >= -50000 && data.profit <= 250000
        && data.accountType in ['demo', 'real']
        && data.createdAt is timestamp;
    }

    // Users collection (PII isolated to owner or admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().licenses.size() == 0
        && incoming().signalSubEnd == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'country', 'theme', 'updatedAt']))
        );
      allow delete: if false;
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().userEmail == request.auth.token.email
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(orderId) && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().userEmail == existing().userEmail
        && incoming().itemId == existing().itemId
        && incoming().amountKsh == existing().amountKsh
        && incoming().amountUsd == existing().amountUsd
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status in ['pending', 'cancelled'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'reference', 'status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // Signals collection
    match /signals/{signalId} {
      allow get: if isValidId(signalId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidId(signalId)
        && isValidSignal(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(signalId) && isValidSignal(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['pair', 'direction', 'entry', 'stopLoss', 'takeProfit', 'timeframe', 'strategy', 'status', 'published', 'notes', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(signalId);
    }

    // MT5 Remote Control configs
    match /mt5Configs/{configId} {
      allow get: if isValidId(configId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(configId)
        && isValidMt5Config(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(configId) && isValidMt5Config(incoming())
        && incoming().userId == existing().userId
        && incoming().eaId == existing().eaId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['eaKey', 'symbol', 'mode', 'lotSize', 'enabled', 'updatedAt']))
        );
      allow delete: if isValidId(configId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Deriv Trade Logs
    match /tradeLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(logId)
        && isValidTradeLog(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Admins lookup collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list, write: if false;
    }
  }
}
