{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered account keyed by normalised email (one person = one account per normalised email).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "emailKey": { "type": "string", "minLength": 3, "maxLength": 160 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "verified": { "type": "boolean" },
        "blocked": { "type": "boolean" },
        "country": { "type": "string", "minLength": 2, "maxLength": 8 },
        "theme": { "type": "string", "enum": ["system", "light", "dark"] },
        "adminNote": { "type": "string", "maxLength": 500 },
        "lastLoginAt": { "type": "number" },
        "created": { "type": "number" }
      },
      "required": ["uid", "emailKey", "email", "name", "verified", "created"]
    },
    "Account": {
      "title": "Account",
      "description": "Subscription expiry, free forex signal state machine, AI scanner credits, and token revocation timestamp.",
      "type": "object",
      "properties": {
        "created": { "type": "number" },
        "subEnd": { "type": "number" },
        "aiFree": { "type": "boolean" },
        "aiLeft": { "type": "number" },
        "aiSigs": { "type": "array" },
        "revokedAt": { "type": "number" },
        "free": { "type": "object" }
      },
      "required": ["created", "subEnd", "free"]
    },
    "License": {
      "title": "License",
      "description": "Map of botId -> entitlement metadata for a normalised email account.",
      "type": "object",
      "properties": {
        "items": { "type": "object" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Reversed-time keyed payment order supporting M-Pesa STK Push, Pochi la Biashara, PayPal, Paystack, and USDT.",
      "type": "object",
      "properties": {
        "ref": { "type": "string", "maxLength": 80 },
        "t": { "type": "number" },
        "botId": { "type": "string", "maxLength": 64 },
        "price": { "type": "number" },
        "usd": { "type": "number" },
        "method": { "type": "string", "enum": ["pochi", "daraja", "paystack", "paypal", "usdt"] },
        "account": { "type": "string", "maxLength": 160 },
        "email": { "type": "string", "maxLength": 160 },
        "name": { "type": "string", "maxLength": 80 },
        "whatsapp": { "type": "string", "maxLength": 24 },
        "mpesa": { "type": "string", "maxLength": 700 },
        "proof": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectReason": { "type": "string", "maxLength": 300 },
        "refundNote": { "type": "string", "maxLength": 300 }
      },
      "required": ["ref", "t", "botId", "price", "method", "account", "status"]
    },
    "OrderRef": {
      "title": "OrderRef",
      "description": "Duplicate guard and reverse lookup for payment codes and order references.",
      "type": "object",
      "properties": {
        "orderKey": { "type": "string" },
        "ref": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "Settings": {
      "title": "Settings",
      "description": "Platform configuration, dynamic prices, custom/edited/hidden catalog bots, and maintenance mode.",
      "type": "object",
      "properties": {
        "pochi": { "type": "string" },
        "whatsapp": { "type": "string" },
        "payMode": { "type": "string" },
        "paypal": { "type": "string" },
        "usdtAddress": { "type": "string" },
        "usdtNetwork": { "type": "string" },
        "usdRate": { "type": "number" },
        "autoApprove": { "type": "boolean" },
        "showUsdForeign": { "type": "boolean" },
        "maintenance": { "type": "boolean" },
        "revokeAll": { "type": "number" }
      }
    },
    "BotEntry": {
      "title": "BotEntry",
      "description": "Admin-added encrypted bot vault payload (max ~900KB in Firestore).",
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "mime": { "type": "string" },
        "box": { "type": "object" },
        "ownerWrap": { "type": "object" }
      }
    },
    "EaKey": {
      "title": "EaKey",
      "description": "MT5 Expert Advisor key, remote settings, login lock, and live synced telemetry.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "bot": { "type": "string" },
        "key": { "type": "string" },
        "cfg": { "type": "object" },
        "status": { "type": "object" },
        "logins": { "type": "array" },
        "lockLogin": { "type": "string" },
        "owner": { "type": "boolean" },
        "licOk": { "type": "boolean" },
        "licT": { "type": "number" }
      }
    },
    "Signal": {
      "title": "Signal",
      "description": "Cached SMC/ICT Forex signals and admin manual signals.",
      "type": "object",
      "properties": {
        "t": { "type": "number" },
        "closed": { "type": "boolean" },
        "signals": { "type": "array" }
      }
    },
    "EngineState": {
      "title": "EngineState",
      "description": "Market Engine configuration, heartbeat, tracked signals, hourly macro brief, and tick lease.",
      "type": "object",
      "properties": {
        "on": { "type": "boolean" },
        "t": { "type": "number" }
      }
    },
    "NewsAi": {
      "title": "NewsAi",
      "description": "Cached 6-hour AI explanation for high/medium impact economic calendar events.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "made": { "type": "number" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable admin action audit trail.",
      "type": "object",
      "properties": {
        "t": { "type": "number" },
        "who": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Site-wide announcement banner shown to users.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "kind": { "type": "string", "enum": ["info", "warning"] },
        "startAt": { "type": "number" },
        "endAt": { "type": "number" },
        "active": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{emailKey}": { "schema": { "$ref": "#/entities/User" }, "description": "Normalised-email user profile registry" },
    "/accounts/{emailKey}": { "schema": { "$ref": "#/entities/Account" }, "description": "Signals subscription, free-trial state, AI credits" },
    "/licenses/{emailKey}": { "schema": { "$ref": "#/entities/License" }, "description": "Purchased bot entitlements per account" },
    "/orders/{orderKey}": { "schema": { "$ref": "#/entities/Order" }, "description": "Newest-first order records" },
    "/orderRefs/{refId}": { "schema": { "$ref": "#/entities/OrderRef" }, "description": "Idempotency & duplicate code guards" },
    "/orderStatus/{orderRef}": { "schema": { "$ref": "#/entities/OrderRef" }, "description": "Safe read-only payment confirmation mirror" },
    "/settings/{docId}": { "schema": { "$ref": "#/entities/Settings" }, "description": "Site config, prices, catalog edits, and broker links" },
    "/botentry/{botId}": { "schema": { "$ref": "#/entities/BotEntry" }, "description": "Admin-uploaded encrypted bot entries" },
    "/eakeys/{key}": { "schema": { "$ref": "#/entities/EaKey" }, "description": "MT5 EA remote control state and telemetry" },
    "/signals/{docId}": { "schema": { "$ref": "#/entities/Signal" }, "description": "Cached SMC/ICT scan and manual signals" },
    "/ai/{docId}": { "schema": { "$ref": "#/entities/Signal" }, "description": "AI top-down market scanner cache" },
    "/engine/{docId}": { "schema": { "$ref": "#/entities/EngineState" }, "description": "Market Engine config, heartbeat, signals, brief, lease" },
    "/newsai/{eventId}": { "schema": { "$ref": "#/entities/NewsAi" }, "description": "6h cached AI analysis per economic event" },
    "/audit/{entryId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Admin audit trail" },
    "/announcements/{annId}": { "schema": { "$ref": "#/entities/Announcement" }, "description": "Active user announcements" },
    "/admins/{uid}": { "schema": { "$ref": "#/entities/User" }, "description": "Verified admin UIDs" }
  }
}
